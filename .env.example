HOST=0.0.0.0
PORT=3000
# PostgreSQL: use a dedicated application login. Leave blank for local SQLite.
DATABASE_URL=postgresql://zhajinhua_app:CHANGE_ME@your-postgres-host:5432/zhajinhua
# Compose settings; GAME_ARCH can be amd64 or arm64.
GAME_ARCH=amd64
GAME_IMAGE=zhajinhua:latest-amd64
GAME_PORT=3001
BIND_IP=0.0.0.0
COOKIE_SECURE=0
